<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Firebase Auth, Firestore & Simon Says Vibration -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".SmritiSathiApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_smriti_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_smriti_logo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SmritiSathi">

        <!-- Splash / Launcher Activity -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registration Activity -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard Activity (General / Info) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Patient Dashboard Activity (High accessibility, min 18sp) -->
        <activity
            android:name=".ui.PatientDashboardActivity"
            android:exported="false" />

        <!-- Caregiver Dashboard Activity -->
        <activity
            android:name=".ui.CaregiverDashboardActivity"
            android:exported="false" />

        <!-- Caregiver Link Patient Activity -->
        <activity
            android:name=".ui.LinkPatientActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cognitive Games (Section C) -->
        <activity
            android:name=".ui.games.GamesHubActivity"
            android:exported="false" />

        <activity
            android:name=".ui.games.MemoryMatchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.games.ObjectRecallActivity"
            android:exported="false" />

        <activity
            android:name=".ui.games.PatternRecognitionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.games.SimonSaysActivity"
            android:exported="false" />

        <!-- Section F Activities -->
        <!-- 1. ReminderActivity -->
        <activity
            android:name=".ui.reminders.ReminderActivity"
            android:exported="false" />

        <!-- 2. ProgressActivity -->
        <activity
            android:name=".ui.progress.ProgressActivity"
            android:exported="false" />

        <!-- 3. MemoryMomentsActivity -->
        <activity
            android:name=".ui.memories.MemoryMomentsActivity"
            android:exported="false" />

        <!-- 4. CaregiverPatientListActivity -->
        <activity
            android:name=".ui.caregiver.CaregiverPatientListActivity"
            android:exported="false" />

        <!-- 5. PatientDetailActivity -->
        <activity
            android:name=".ui.caregiver.PatientDetailActivity"
            android:exported="false" />

        <!-- 6. CaregiverAlertsActivity -->
        <activity
            android:name=".ui.caregiver.CaregiverAlertsActivity"
            android:exported="false" />

        <!-- Section G: Voice Companion -->
        <activity
            android:name=".ui.voice.TalkToSathiActivity"
            android:exported="false"
            android:theme="@style/Theme.SmritiSathi" />

    </application>

</manifest>
