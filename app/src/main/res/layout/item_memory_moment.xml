<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMemoryMoment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/memoryCardBorder"
    app:strokeWidth="1.5dp"
    app:cardBackgroundColor="@color/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:id="@+id/ivMemoryPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Family memory photo"
                android:background="@color/colorSurfaceVariant"
                android:src="@drawable/ic_photo_library" />

            <!-- Subdued gradient vignette at bottom for contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_header_gradient"
                android:alpha="0.3" />
        </FrameLayout>

        <!-- Tap-to-Reveal Interaction Container -->
        <LinearLayout
            android:id="@+id/layoutTapContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/memoryCardBg">

            <!-- Unrevealed State (Default) -->
            <LinearLayout
                android:id="@+id/layoutUnrevealed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvTapPrompt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tap_to_reveal"
                    android:textColor="@color/colorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_card_heart"
                    android:contentDescription="Reveal icon"
                    app:tint="@color/memoryAccent" />
            </LinearLayout>

            <!-- Revealed State (Shown on Tap) -->
            <LinearLayout
                android:id="@+id/layoutRevealed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Person Name (High visibility 24sp) -->
                <TextView
                    android:id="@+id/tvMemoryPersonName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Priya Sharma"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Relationship Badge -->
                <TextView
                    android:id="@+id/tvMemoryRelationship"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_rounded_card"
                    android:text="Your Loving Daughter ❤️"
                    android:textColor="@color/memoryAccent"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Optional Story / Description -->
                <TextView
                    android:id="@+id/tvMemoryDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Taken during Diwali celebrations at your home in Jaipur."
                    android:textColor="@color/textSecondary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap again to hide"
                    android:textColor="@color/textTertiary"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
