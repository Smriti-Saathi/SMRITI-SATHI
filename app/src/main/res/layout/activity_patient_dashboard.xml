<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header Hero Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Top Bar: App Title and Logout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_smriti_logo" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/app_name"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPatientLogout"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/logout"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            app:strokeColor="@color/white"
                            app:strokeWidth="1.5dp" />
                    </LinearLayout>

                    <!-- Time-based Warm Greeting for Elderly User -->
                    <TextView
                        android:id="@+id/tvPatientGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Good morning, Friend! 🌸"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <!-- Today's Date Display -->
                    <TextView
                        android:id="@+id/tvPatientDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Today is a peaceful day"
                        android:textColor="#E0F2FE"
                        android:textSize="18sp" />

                </LinearLayout>
            </FrameLayout>

            <!-- Main Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="-20dp"
                android:orientation="vertical">

                <!-- 1. "PLAY TODAY'S GAME" CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPlayGame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/gameCardBg"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/gameCardBorder">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/play_todays_game_title"
                                android:src="@drawable/ic_game" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="@string/play_todays_game_title"
                                android:textColor="#166534"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/play_todays_game_subtitle"
                            android:textColor="@color/textPrimary"
                            android:lineSpacingExtra="4dp"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayGame"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/play_todays_game_btn"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/gameButtonTint"
                            app:cornerRadius="16dp"
                            app:elevation="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. NEXT-REMINDER PREVIEW CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNextReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/reminderCardBg"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/reminderCardBorder">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:contentDescription="@string/next_reminder_title"
                                android:src="@drawable/ic_alarm" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="@string/next_reminder_title"
                                android:textColor="#854D0E"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Active Reminder Details Container -->
                        <LinearLayout
                            android:id="@+id/layoutReminderDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_rounded_card"
                            android:orientation="vertical"
                            android:padding="18dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvReminderTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Blood Pressure Medicine"
                                android:textColor="@color/textPrimary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReminderTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="⏰ Scheduled for 2:00 PM"
                                android:textColor="#854D0E"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvReminderDosage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Dosage: 1 Tablet after lunch"
                                android:textColor="@color/textSecondary"
                                android:textSize="18sp" />

                        </LinearLayout>

                        <!-- Empty State message if no reminders pending -->
                        <TextView
                            android:id="@+id/tvNoReminders"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/no_pending_reminders"
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. MEMORY MOMENTS SHORTCUT CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMemoryMoments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/memoryCardBg"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/memoryCardBorder">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:contentDescription="@string/memory_moments_title"
                                android:src="@drawable/ic_photo_library" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="@string/memory_moments_title"
                                android:textColor="#6B21A8"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/memory_moments_subtitle"
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMemoryMoments"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="18dp"
                            android:text="View Family Memories 📸"
                            android:textColor="#6B21A8"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:strokeColor="#9333EA"
                            app:strokeWidth="2dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. WELLNESS PROGRESS & COGNITIVE HEALTH CARD (Section F) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWellnessJourney"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="90dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/colorPrimaryContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:contentDescription="Wellness Progress"
                                android:src="@drawable/ic_card_star"
                                app:tint="@color/colorSecondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="My Wellness Journey 🌿"
                                android:textColor="@color/colorPrimaryDark"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="See your daily brain exercise growth and encouraging progress milestones."
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewProgress"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="18dp"
                            android:text="View My Progress 🌟"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/colorPrimary"
                            app:strokeWidth="2dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 4. FLOATING "TALK TO SATHI" BUTTON (Min 18sp text, large touch target 64dp, high elevation) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/fabTalkToSathi"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_sathi_fab"
        android:paddingStart="28dp"
        android:paddingEnd="32dp"
        android:text="@string/talk_to_sathi"
        android:textColor="@color/sathiFabText"
        android:textSize="20sp"
        android:textStyle="bold"
        android:elevation="10dp"
        app:backgroundTint="@color/sathiFabBg"
        app:cornerRadius="34dp"
        app:icon="@drawable/ic_mic"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="30dp"
        app:iconTint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
